# NollenBlaze local environment example.
# Never commit a real .env file.
# The client secret stays only in the backend.
# Refresh tokens and access tokens stay only in secure backend storage.
# Browser/frontend code must never receive BLAZE_CLIENT_SECRET.

BLAZE_CLIENT_ID=<public_client_id>
BLAZE_CLIENT_SECRET=<placeholder_apenas_backend>
BLAZE_REDIRECT_URI=http://localhost:8080/api/blaze/oauth/callback
BLAZE_AUTH_BASE_URL=https://blaze.stream
BLAZE_API_BASE_URL=https://api.blaze.stream
BLAZE_SOCKET_URL=https://blaze.stream
BLAZE_SOCKET_PATH=/ws
BLAZE_SCOPES=users.read,offline.access
BLAZE_MONITORED_CHANNEL_ID=<optional_channel_uuid>
NOLLEN_API_KEY=dev-local-key
# Producao: o build do frontend precisa de VITE_NOLLEN_API_KEY com o MESMO valor
# desta chave (ver frontend/.env.example e a secao "Build unico" do README).
# Sem isso, o SPA em producao recebe 401 em todas as chamadas de /api/**.
SESSION_COOKIE_SECURE=false
NOLLEN_DB_URL=jdbc:h2:file:./data/nollenblaze-dev;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
# Producao (Supabase): NOLLEN_DB_URL=jdbc:postgresql://<projeto>.pooler.supabase.com:6543/postgres?sslmode=require
# ATENCAO: a variavel de usuario e NOLLEN_DB_USER (application.yml le NOLLEN_DB_USER).
# NOLLEN_DB_USERNAME NAO existe — definir o nome errado mantem o default H2 em silencio.
NOLLEN_DB_USER=sa
NOLLEN_DB_PASSWORD=
